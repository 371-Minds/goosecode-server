# ==============================================================================
# Goosecode Swarm — Environment Variables
# Copy to .env and fill in the values before running docker compose up
# ==============================================================================

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------
# OpenAI API key for Goose AI
OPENAI_API_KEY=your_openai_api_key_here
# Password for VS Code Server and Goose API authentication
PASSWORD=talktomegoose
# GitHub personal access token (used by gh CLI and git credential helper)
GITHUB_TOKEN=your_github_token_here

# ------------------------------------------------------------------------------
# Git identity
# ------------------------------------------------------------------------------
GIT_USER_NAME=Goosecode Swarm
GIT_USER_EMAIL=swarm@goosecode.ai

# ------------------------------------------------------------------------------
# Goose AI settings
# ------------------------------------------------------------------------------
# AI provider: openai | anthropic | google | etc.
GOOSE_PROVIDER=openai
# Model name (must be supported by the provider above)
GOOSE_MODEL=o3-mini-2025-01-31
# Terminal mode: read-write (agents can execute) | read-only (observe only)
DEFAULT_TERMINAL_MODE=read-write
# Named session — leave blank to auto-generate
# GOOSE_SESSION_ID=my-session-name
# Set to 'true' to resume an existing session instead of starting fresh
# GOOSE_RESUME_SESSION=true

# ------------------------------------------------------------------------------
# Server ports
# ------------------------------------------------------------------------------
PORT=8080
API_PORT=8000

# ------------------------------------------------------------------------------
# Feature flags
# ------------------------------------------------------------------------------
ENABLE_TERMINAL_SHARING=true
ENABLE_GOOSE_API=true

# ------------------------------------------------------------------------------
# Biological Data Stack connection strings
# (auto-populated by docker-compose.yml; override for external services)
# ------------------------------------------------------------------------------
CLICKHOUSE_URL=http://clickhouse:8123
REDIS_URL=redis://:goosepass@redis:6379
CHROMADB_URL=http://chromadb:8001
CERAMIC_URL=http://ceramic:7007
SQLITE_PATH=/workspace/.db/agent_state.sqlite

# ------------------------------------------------------------------------------
# Frontend / Deployment tokens (needed by goose-vercel distro)
# ------------------------------------------------------------------------------
# VERCEL_TOKEN=your_vercel_token_here
# EXPO_TOKEN=your_expo_token_here
# EAS_PROJECT_ID=your_eas_project_id_here

# ------------------------------------------------------------------------------
# Mindport / DNS integrations (needed by goose-mindport distro)
# ------------------------------------------------------------------------------
# MINDPORT_TLD=localhost
# MINDPORT_PROXY_PORT=1355
# MINDPORT_DNS_PROVIDER=openprovider
# OPENPROVIDER_USERNAME=your_openprovider_username
# OPENPROVIDER_PASSWORD=your_openprovider_password
# PORKBUN_API_KEY=your_porkbun_api_key
# PORKBUN_SECRET_KEY=your_porkbun_secret_key
# NAMECHEAP_API_USER=your_namecheap_api_user
# NAMECHEAP_API_KEY=your_namecheap_api_key
# NAMECHEAP_USERNAME=your_namecheap_username
# NAMECHEAP_CLIENT_IP=your_public_ip
# FREENAME_API_KEY=your_freename_api_key
# FREENAME_API_SECRET=your_freename_api_secret

# ------------------------------------------------------------------------------
# Akash Network (needed by goose-akash distro)
# ------------------------------------------------------------------------------
# AKASH_KEY_NAME=mykey
# AKASH_KEYRING_BACKEND=os
# AKASH_NODE=https://rpc.akashnet.net:443
# AKASH_CHAIN_ID=akashnet-2

# ------------------------------------------------------------------------------
# Runtime integration homes (set automatically by the matching goose-* distro)
# ------------------------------------------------------------------------------
# PICOLLM_HOME=/opt/integrations/picollm
# MII_HOME=/opt/integrations/mii
# MNN_HOME=/opt/integrations/mnn
# RYZENAI_HOME=/opt/integrations/ryzenai
# EXLLAMAV3_HOME=/opt/integrations/exllamav3
# ENVMINDS_HOME=/opt/integrations/envminds
# MINDPORT_HOME=/opt/integrations/mindport

# ------------------------------------------------------------------------------
# Automaton orchestration (optional)
# ------------------------------------------------------------------------------
# AUTOMATON_URL=https://your-automaton-instance/
# AUTOMATON_TASK_ID=task-abc123
